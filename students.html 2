<!DOCTYPE html>
<html lang="hi">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Student Registration - Suriya Coaching Centre</title>

<style>

*{
box-sizing:border-box;
}

body{
margin:0;
font-family:Arial,sans-serif;
background:linear-gradient(135deg,#1565c0,#42a5f5);
min-height:100vh;
display:flex;
align-items:center;
justify-content:center;
}

.box{
width:92%;
max-width:430px;
background:white;
padding:25px;
border-radius:18px;
box-shadow:0 8px 25px rgba(0,0,0,.25);
}

h1{
text-align:center;
color:#1565c0;
margin-bottom:5px;
}

.subtitle{
text-align:center;
color:#666;
margin-bottom:25px;
}

label{
display:block;
font-weight:bold;
margin-top:15px;
margin-bottom:6px;
}

input,select{
width:100%;
padding:13px;
border:1px solid #ccc;
border-radius:8px;
font-size:16px;
}

button{
width:100%;
padding:13px;
margin-top:18px;
border:0;
border-radius:8px;
background:#1565c0;
color:white;
font-size:16px;
font-weight:bold;
}

button:hover{
background:#0d47a1;
}

.message{
text-align:center;
margin-top:15px;
font-weight:bold;
}

.login{
background:#555;
}

</style>
</head>

<body>

<div class="box">

<h1>🎓 Student Registration</h1>

<div class="subtitle">
Suriya Coaching Centre
</div>


<label>Student Name</label>

<input
type="text"
id="studentName"
placeholder="अपना नाम लिखें"
>


<label>Mobile Number</label>

<input
type="tel"
id="studentMobile"
placeholder="10 अंकों का मोबाइल नंबर"
maxlength="10"
>


<label>अपनी कक्षा चुनें</label>

<select id="studentClass">

<option value="">
-- कक्षा चुनें --
</option>

<option value="9">
कक्षा 9
</option>

<option value="10">
कक्षा 10
</option>

<option value="11">
कक्षा 11
</option>

<option value="12">
कक्षा 12
</option>

</select>


<button onclick="registerStudent()">
📝 Registration करें
</button>


<div id="message" class="message"></div>


<button class="login" onclick="openLogin()">
🔐 Student Login
</button>

</div>


<script>

function registerStudent(){

let name =
document.getElementById("studentName")
.value.trim();

let mobile =
document.getElementById("studentMobile")
.value.trim();

let studentClass =
document.getElementById("studentClass")
.value;


if(name === ""){

showMessage(
"❌ अपना नाम लिखिए",
"red"
);

return;

}


if(!/^[0-9]{10}$/.test(mobile)){

showMessage(
"❌ सही 10 अंकों का मोबाइल नंबर डालिए",
"red"
);

return;

}


if(studentClass === ""){

showMessage(
"❌ अपनी कक्षा चुनिए",
"red"
);

return;

}


let students =
JSON.parse(
localStorage.getItem("suriyaStudents") || "[]"
);


/* मोबाइल नंबर पहले से मौजूद है या नहीं */

let alreadyExists =
students.some(function(student){

return student.mobile === mobile;

});


if(alreadyExists){

showMessage(
"⚠️ यह मोबाइल नंबर पहले से Registered है",
"red"
);

return;

}


students.push({

name:name,

mobile:mobile,

className:studentClass

});


localStorage.setItem(
"suriyaStudents",
JSON.stringify(students)
);


showMessage(
"✅ Registration सफल हुआ। आपकी कक्षा: " +
studentClass,
"green"
);


document.getElementById("studentName")
.value="";

document.getElementById("studentMobile")
.value="";

document.getElementById("studentClass")
.value="";

}


function showMessage(text,color){

let message =
document.getElementById("message");

message.innerHTML=text;

message.style.color=color;

}


function openLogin(){

alert(
"Student Login का पेज अगले चरण में जोड़ेंगे।"
);

}

</script>

</body>
</html>
